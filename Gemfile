source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages builds with.
# Run locally with: bundle exec jekyll serve --config _config.yml,_config.dev.yml
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
end

# Gems removed from Ruby's default set, needed by Jekyll 3.x
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
